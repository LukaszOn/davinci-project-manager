<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.8.0</Version>
    <AssemblyName>DaVinciProjectManager</AssemblyName>
    <RootNamespace>ProjectLibraryDesk</RootNamespace>
    <ApplicationIcon>Assets/Desk.ico</ApplicationIcon>
    <Product>DaVinci Project Manager</Product>
    <Description>PostgreSQL tools for DaVinci Resolve project libraries</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
    <!-- Avalonia records absolute XAML paths even in a path-mapped embedded PDB. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Desk.png" />
    <AvaloniaResource Include="Assets/Desk.ico" />
    <EmbeddedResource Include="UiStrings.en.json" LogicalName="UiStrings.en.json" WithCulture="false" />
    <EmbeddedResource Include="UiStrings.pl.json" LogicalName="UiStrings.pl.json" WithCulture="false" />
    <EmbeddedResource Include="sql/registry-layout.sql" LogicalName="RegistryLayout.sql" />
    <EmbeddedResource Include="PgToolPackages.json" LogicalName="PgToolPackages.json" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Npgsql" Version="10.0.4" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <None Update="sql\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
